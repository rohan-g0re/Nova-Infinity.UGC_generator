# Anthropic Claude API key (required for script generation)
ANTHROPIC_API_KEY=

# ElevenLabs API key (required for voice cloning and TTS)
ELEVENLABS_API_KEY=

# Sync.so API key (required for lip-sync)
SYNC_SO_API_KEY=

# Pexels API key (for stock footage search)
PEXELS_API_KEY=

# Pixabay API key (for stock footage/image search)
PIXABAY_API_KEY=

# Fal.ai API key (for AI image/video generation)
FAL_KEY=

# Google Gemini / Veo 3.1 video generation
GEMINI_API_KEY=
# OpenAI / Sora 2 video generation
OPENAI_API_KEY=
# B-roll backend priority (comma-separated: sora,veo,kling,stock)
BROLL_BACKENDS=sora,veo,kling,stock
# Max generative (sora/veo/kling) clips per run; rest fall back to stock
MAX_GEN_CLIPS=2

# Mock mode toggles
# Set to 1 to force mock lip-sync (skip real Sync.so API call)
SYNC_MOCK=
